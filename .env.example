# -------------------------------------------------------------------
# Django
# -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Used by production/staging settings when configured.
# Development currently allows all origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------
POSTGRES_DB=journal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432


# -------------------------------------------------------------------
# MinIO
# -------------------------------------------------------------------
# Docker Compose uses these to initialize MinIO.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-minio-root-password

# Django storage configuration.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-minio-root-password
MINIO_BUCKET_NAME=journal-submissions
MINIO_REGION=us-east-1
MINIO_USE_SSL=False

# -------------------------------------------------------------------
# Embeddings
# -------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
