# -------------------------------------------------------------------
# Django
# -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Used by production/staging settings when configured.
# Development currently allows all origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public frontend used for links in email notifications.
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------
# Email notifications
# -------------------------------------------------------------------
# Console backend is safe for local development: messages are printed
# in the process output instead of being sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Required only when EMAIL_BACKEND uses SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=IJMS <no-reply@example.com>

# Send one reminder this many days before the review deadline.
REVIEW_DEADLINE_REMINDER_DAYS=2

# -------------------------------------------------------------------
# Celery / Redis
# -------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------
POSTGRES_DB=journal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432


# -------------------------------------------------------------------
# MinIO
# -------------------------------------------------------------------
# Docker Compose uses these to initialize MinIO.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-minio-root-password

# Django storage configuration.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-minio-root-password
MINIO_BUCKET_NAME=journal-submissions
MINIO_REGION=us-east-1
MINIO_USE_SSL=False

# -------------------------------------------------------------------
# Embeddings
# -------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# -------------------------------------------------------------------
# Arabic plagiarism screening
# -------------------------------------------------------------------
# Disabled by default because models, indexes, and the source corpus
# are deployment-specific and are not stored in Git.
PLAGIARISM_ENABLED=False

# Read-only resource directory mounted into plagiarism_worker.
PLAGIARISM_RESOURCE_ROOT=/pipeline_resources

# Writable generated caches. Docker Compose stores this in a volume.
PLAGIARISM_CACHE_ROOT=/var/cache/ijms-plagiarism

# The pipeline reads its indexed source corpus from PostgreSQL.
PLAGIARISM_DATABASE_URL=postgresql://journal_user:replace-with-a-database-password@db:5432/journal_db

# Must exactly match the source_documents rows and semantic-cache prefix.
PLAGIARISM_SOURCE_TYPE=replace-with-indexed-source-type

# Provenance recorded with every screening.
PLAGIARISM_PIPELINE_VERSION=383efcaca1b074cc60bd1fb7a7488f719ae8b183
PLAGIARISM_CHECKPOINT_ID=f2_x2_o1_c1/best_model.pt

# Local semantic retrieval and model resources.
PLAGIARISM_SEMANTIC_BACKEND=local
PLAGIARISM_E5_MODEL_DIRECTORY=/pipeline_resources/models/multilingual-e5-base
PLAGIARISM_ARAT5_MODEL_DIRECTORY=/pipeline_resources/models/AraT5v2-base-1024
PLAGIARISM_CHECKPOINT_PATH=/pipeline_resources/models/verifier/f2_x2_o1_c1/best_model.pt
PLAGIARISM_SEMANTIC_CACHE_DIRECTORY=/pipeline_resources/cache/semantic
PLAGIARISM_BM25_CACHE_DIRECTORY=/var/cache/ijms-plagiarism/bm25

# Safe CPU defaults for the graduation-project deployment.
PLAGIARISM_DEVICE=cpu
PLAGIARISM_E5_DEVICE=cpu
PLAGIARISM_MIXED_PRECISION=none