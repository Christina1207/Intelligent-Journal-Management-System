# -------------------------------------------------------------------
# Django
# -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Used by production/staging settings when configured.
# Development currently allows all origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------
POSTGRES_DB=journal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -------------------------------------------------------------------
# Celery and Redis
# -------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -------------------------------------------------------------------
# MinIO
# -------------------------------------------------------------------
# Docker Compose uses these to initialize MinIO.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-minio-root-password

# Django storage configuration.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-minio-root-password
MINIO_BUCKET_NAME=journal-submissions
MINIO_REGION=us-east-1
MINIO_USE_SSL=False

# -------------------------------------------------------------------
# Embeddings
# -------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# -------------------------------------------------------------------
# Journal workflow policy
# -------------------------------------------------------------------
REQUIRED_REVIEWS_COUNT=2
MAX_REVISION_ROUNDS=3
REVISION_REVIEW_DEADLINE_DAYS=14
REVIEWER_RECOMMENDATION_COUNT=5
MAX_ACTIVE_REVIEWER_ASSIGNMENTS=3

# -------------------------------------------------------------------
# Topic modeling
# -------------------------------------------------------------------
# Kept low for the defense dataset. Increase for real deployments.
MIN_SUBMISSIONS_FOR_CLUSTERING=3

# -------------------------------------------------------------------
# ORCID and task execution
# -------------------------------------------------------------------
ORCID_REFRESH_INTERVAL_DAYS=30
CELERY_TASK_MAX_RETRIES=3